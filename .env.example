# ---------------------------------------------------------------------------
# Pawcare API configuration
# Copy this file to `.env` and fill in every value.
# Keep every value in double quotes - an unquoted "#" or trailing space breaks
# parsing silently, which is the hardest class of bug to track down.
# ---------------------------------------------------------------------------


# ---- Server ----
NODE_ENV="production"
PORT="4000"

# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGIN="http://localhost:3000,http://localhost:4173,http://localhost:5174,https://pawcare.lol,https://www.pawcare.lol,https://your-site.netlify.app"

# Resolvers used for MongoDB SRV lookups. Some ISP/corporate resolvers (and
# loopback filtering proxies) answer REFUSED for SRV queries, which makes every
# mongodb+srv:// connection fail with `querySrv ECONNREFUSED`.
DNS_SERVERS="8.8.8.8,1.1.1.1"

# ---- MongoDB ----
# Atlas > Database Access > your user > Edit > Password
MONGODB_URI="mongodb+srv://YOUR_USERNAME:YOUR_URLENCODED_PASSWORD@cluster0.example.mongodb.net/pawcare?retryWrites=true&w=majority"

# ---- Auth ----
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="7d"

# The admin account is created automatically on first start from these values.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# ---- Cloudinary (article image uploads) ----
# Cloudinary dashboard > Product Environment Credentials
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ---- Netlify (optional) ----
# Netlify > Site configuration > Build & deploy > Build hooks.
# Enables the "Publish & rebuild" button. Leave empty to disable.
NETLIFY_BUILD_HOOK="https://api.netlify.com/build_hooks/your-hook-id"
